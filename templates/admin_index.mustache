{{!
    @template block_le_dashboard/admin_index

    Index admin page: row counts, status and the rebuild button.

    Example context (json):
    {
        "counts": [{"label": "Activities: 12"}, {"label": "Student rows: 340"}, {"label": "Marking rows: 290"}],
        "status": "Last filled 6 October 2026, 08:00",
        "rebuildurl": "https://example.com/blocks/le_dashboard/admin/index.php?rebuild=1"
    }
}}
<p>{{#str}}indexpage_desc, block_le_dashboard{{/str}}</p>
<ul class="list-unstyled" data-region="ma-index-counts">
    {{#counts}}<li>{{label}}</li>{{/counts}}
</ul>
{{#status}}<p>{{status}}</p>{{/status}}
<form method="get" action="{{rebuildurl}}">
    <input type="hidden" name="rebuild" value="1">
    <button type="submit" class="btn btn-secondary">{{#str}}rebuildindex, block_le_dashboard{{/str}}</button>
</form>
