{{!
    @template block_my_assessments/admin_years

    Academic years admin list.

    Example context (json):
    {"hasrows": true, "rows": [{"label": "2026/27", "start": "1 September 2026", "end": "31 August 2027", "editurl": "#", "deleteurl": "#"}]}
}}
{{#hasrows}}
<table class="table table-sm generaltable">
    <thead>
        <tr>
            <th scope="col">{{#str}}yearlabel, block_my_assessments{{/str}}</th>
            <th scope="col">{{#str}}yearstart, block_my_assessments{{/str}}</th>
            <th scope="col">{{#str}}yearlastday, block_my_assessments{{/str}}</th>
            <th scope="col"><span class="sr-only">{{#str}}actions{{/str}}</span></th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr>
            <th scope="row">{{label}}</th>
            <td>{{start}}</td>
            <td>{{end}}</td>
            <td><a href="{{editurl}}">{{#str}}edit{{/str}}</a> · <a href="{{deleteurl}}" class="text-danger">{{#str}}delete{{/str}}</a></td>
        </tr>
        {{/rows}}
    </tbody>
</table>
{{/hasrows}}
{{^hasrows}}<p>{{#str}}noyears, block_my_assessments{{/str}}</p>{{/hasrows}}
