{{!
    @template block_le_dashboard/checklist

    A module convenor's quiet line under the control bar: one collapsed summary that opens to a
    collapsed line per course, each listing activities linked to their pages. Blocks: region
    (data-region) and icon (Font Awesome name).

    Example context (json):
    {"label": "You have 2 compatible but untagged activities across your courses.", "guidance": null,
     "courses": [{"course": "Module 1", "courseurl": "#", "count": 2, "activities": [{"name": "Essay", "url": "#", "hidden": true,
     "problems": "No due date"}]}]}
}}
<details class="ma-untagged" data-region="{{$region}}ma-untagged{{/region}}">
    <summary class="ma-untagged-summary"><i class="fa-solid {{$icon}}fa-tag{{/icon}} ma-icon" aria-hidden="true"></i>{{label}}</summary>
    <div class="ma-untagged-body">
        {{#guidance}}<div class="ma-untagged-guidance">{{{guidance}}}</div>{{/guidance}}
        {{#courses}}
        <details class="ma-untagged-course">
            <summary class="ma-untagged-summary"><a href="{{courseurl}}">{{course}}</a> ({{count}})</summary>
            <ul class="ma-untagged-list">
                {{#activities}}
                <li><a href="{{url}}">{{name}}</a>{{#problems}}<span class="ma-untagged-problems">{{.}}</span>{{/problems}}{{#hidden}}<span class="ma-untagged-hidden"><i class="fa-solid fa-eye-slash ma-icon" aria-hidden="true"></i>{{#str}}hint_hidden, block_le_dashboard{{/str}}</span>{{/hidden}}</li>
                {{/activities}}
            </ul>
        </details>
        {{/courses}}
    </div>
</details>
