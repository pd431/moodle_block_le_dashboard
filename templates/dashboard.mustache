{{!
    @template block_my_assessments/dashboard

    The dashboard: view tabs and the open view. JS hooks are data- attributes only.

    Example context (json):
    {
        "uniqid": "ma-dashboard1",
        "hastabs": true,
        "tabs": [{"key": "student", "label": "Student", "active": true}, {"key": "staff", "label": "Marking", "active": false}],
        "activeview": "student",
        "view": {"key": "student", "uniqid": "ma1", "sections": [], "summary": [], "freshness": {"text": "Updated just now"} }
    }
}}
<div id="{{uniqid}}" class="block_my_assessments_dashboard" data-region="ma-dashboard" data-view="{{activeview}}">
    {{#hastabs}}
    <ul class="nav nav-tabs ma-tabs" role="tablist">
        {{#tabs}}
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link{{#active}} active{{/active}}" role="tab"
                    aria-selected="{{#active}}true{{/active}}{{^active}}false{{/active}}"
                    data-action="switch-view" data-view="{{key}}">{{label}}</button>
        </li>
        {{/tabs}}
    </ul>
    {{/hastabs}}
    <div class="ma-loading alert alert-info" data-region="ma-loading" role="status" hidden>
        <span class="spinner-border spinner-border-sm mr-2" aria-hidden="true"></span>{{#str}}loading, block_my_assessments{{/str}}
    </div>
    <div data-region="ma-view" aria-live="polite">
        {{#view}}{{> block_my_assessments/view }}{{/view}}
    </div>
</div>
