{{!
    @template block_le_dashboard/datedtext

    A sentence with a date in it (format::dated()). The date is a time element, so the page can show it in the
    viewer's own time zone like the row dates (localtime.js).

    Example context (json):
    {"before": "Their work may still arrive. The latest extended deadline is ", "date": "21 Oct 2026, 12:00",
     "iso": "2026-10-21T12:00:00+01:00", "after": "."}
}}
{{before}}<time datetime="{{iso}}" data-intext="1">{{date}}</time>{{after}}
