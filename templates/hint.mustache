{{!
    @template block_le_dashboard/hint

    A hint: one icon, with its count when it has one, that opens a popover with its title and
    description on a click, keyboard focus or a short hover (dashboard.js). Staff flags keep a
    tinted outline; student hints (glyph) are bare icons. The icon's name is the full title.

    Example context (json):
    {"id": "ma-row-12-hint-unallocated", "key": "unallocated", "icon": "fa-user-slash", "tone": "attention",
     "glyph": false, "title": "3 unallocated", "count": 3, "text": "Includes 3 submissions not yet allocated.", "link": null}
}}
<span class="ma-tip-wrap ma-tip-wrap--row ma-flag-wrap">
    <button type="button" class="ma-flag ma-flag--{{tone}}{{#glyph}} ma-flag--glyph{{/glyph}}" data-action="tip"
            data-hint="{{key}}" aria-expanded="false" aria-controls="{{id}}" aria-label="{{title}}">
        <i class="fa-solid {{icon}}" aria-hidden="true"></i>{{#count}}<span class="ma-flag-count" aria-hidden="true">{{count}}</span>{{/count}}
    </button>
    <span class="ma-tip ma-tip--wide" id="{{id}}" data-region="ma-tip" hidden><strong class="ma-tip-title">{{title}}</strong>{{text}}{{#link}} {{{link}}}{{/link}}</span>
</span>
