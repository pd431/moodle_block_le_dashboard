{{!
    @template block_le_dashboard/hint

    A hint on a row: a small button that opens a tip by click or focus, never hover. The same
    component for every hint, in the row's meta line or next to a grade.

    Example context (json):
    {"id": "ma-row-12-hint-brief", "key": "brief", "icon": "fa-circle-info", "label": "No brief", "text": "This assessment has no brief.", "link": null}
}}
<span class="ma-tip-wrap ma-tip-wrap--row">
    <button type="button" class="btn btn-sm ma-btn ma-btn--hint" data-action="tip" data-hint="{{key}}"
            aria-expanded="false" aria-controls="{{id}}">
        <i class="fa-solid {{icon}}{{^icon}}fa-circle-info{{/icon}}" aria-hidden="true"></i> {{label}}
    </button>
    <span class="ma-tip ma-tip--wide" id="{{id}}" data-region="ma-tip" hidden>{{text}}{{#link}} {{{link}}}{{/link}}</span>
</span>
