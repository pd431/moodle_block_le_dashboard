{{!
    @template block_le_dashboard/progress

    A labelled progress bar. The count is always shown as text next to the bar.

    Example context (json):
    {"key": "marked", "label": "Marked", "value": 1, "max": 2, "percent": 50, "text": "1 of 2"}
}}
<div class="ma-bar ma-bar--{{key}}" data-bar="{{key}}" data-value="{{value}}" data-max="{{max}}">
    <span class="ma-bar-label">{{label}}</span>
    <div class="progress ma-bar-track" role="progressbar" aria-label="{{label}}" aria-valuemin="0" aria-valuemax="{{max}}"
         aria-valuenow="{{value}}" aria-valuetext="{{text}}">
        <div class="progress-bar ma-bar-fill" style="width: {{percent}}%"></div>
    </div>
    <span class="ma-bar-text" aria-hidden="true">{{text}}</span>
</div>
