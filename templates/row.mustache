{{!
    @template block_le_dashboard/row

    One assessment row, the same partial in every view. The parts a view doesn't send are left out.

    Example context (json):
    {
        "id": "ma-student-12",
        "cmid": 12,
        "view": "student",
        "name": "Essay 1",
        "url": "https://example.com/mod/assign/view.php?id=12",
        "course": "M1",
        "modlabel": "Assignment",
        "faicon": "fa-file-arrow-up",
        "tip": "Assignment. Extension granted. Due soon.",
        "assesstype": "summative",
        "typelabel": "Summative",
        "search": "essay 1 m1 assignment",
        "overflow": false,
        "overlay": {"state": "duesoon", "icon": "fa-clock"},
        "mitigationoverlay": {"state": "extension", "icon": "fa-calendar-plus"},
        "hiddenhint": null,
        "hints": [],
        "hasflags": false,
        "status": {"key": "pending", "label": "Not submitted yet"},
        "dates": [{"key": "due", "label": "Due", "text": "5 Oct 2026, 17:00", "iso": "2026-10-05T17:00:00+01:00"}],
        "actions": [{"key": "submit", "label": "Submit", "icon": "fa-upload", "url": "https://example.com/mod/assign/view.php?id=12"}]
    }
}}
<li class="list-group-item ma-row" id="{{id}}" data-region="ma-row" data-cmid="{{cmid}}" data-assesstype="{{assesstype}}"{{#tomark}} data-tomark="{{tomark}}"{{/tomark}}
    data-search="{{search}}"{{#overflow}} data-overflow="1" hidden{{/overflow}}>
    <div class="ma-row-icon ma-tip-wrap">
        <button type="button" class="ma-row-iconbtn" data-action="tip" data-region="ma-row-icon" aria-expanded="false" aria-controls="{{id}}-tip"
                aria-label="{{tip}}">
            <i class="fa-solid {{faicon}} ma-row-faicon" aria-hidden="true"></i>
            {{#hasmodifiers}}
            <span class="ma-row-modifiers" aria-hidden="true">
                {{#mitigationoverlay}}<span class="ma-row-overlay ma-row-overlay--{{state}}"><i class="fa-solid {{icon}}"></i></span>{{/mitigationoverlay}}
                {{#overlay}}<span class="ma-row-overlay ma-row-overlay--{{state}}"><i class="fa-solid {{icon}}"></i></span>{{/overlay}}
            </span>
            {{/hasmodifiers}}
        </button>
        <div class="ma-tip" id="{{id}}-tip" data-region="ma-tip" hidden>{{tip}}</div>
    </div>
    <div class="ma-row-info">
        <a class="ma-row-name" href="{{url}}">{{name}}</a>
        <div class="ma-row-meta{{#stacked}} ma-row-meta--stacked{{/stacked}}">
            <span class="ma-row-course">{{course}}</span>
            <span class="ma-row-type">{{typeline}}</span>
            {{#hasflags}}
            <span class="ma-flags">{{#hiddenhint}}{{> block_le_dashboard/hint }}{{/hiddenhint}}{{#hints}}{{> block_le_dashboard/hint }}{{/hints}}</span>
            {{/hasflags}}
        </div>
    </div>
    <div class="ma-row-dates">
        {{#dates}}
        <div class="ma-row-date ma-row-date--{{key}}" data-date="{{key}}">
            {{#label}}<span class="ma-row-date-label">{{label}}</span> {{/label}}<time datetime="{{iso}}">{{text}}</time>{{#hint}}{{> block_le_dashboard/hint }}{{/hint}}
        </div>
        {{/dates}}
        {{#notes}}<div class="ma-row-note">{{.}}</div>{{/notes}}
        {{#alert}}<div class="ma-row-alert" data-region="ma-alert">{{alert}}</div>{{/alert}}
    </div>
    <div class="ma-row-status">
        {{#status}}<span class="ma-status-wrap"><span class="badge ma-pill ma-pill--{{key}}" data-status="{{key}}">{{label}}</span>{{#statushint}}{{> block_le_dashboard/hint }}{{/statushint}}</span>{{/status}}
        {{#grade}}<span class="ma-grade" data-region="ma-grade">{{#str}}grade, block_le_dashboard{{/str}} <strong>{{text}}</strong>{{#hint}}{{> block_le_dashboard/hint }}{{/hint}}</span>{{/grade}}
        {{#bars}}{{> block_le_dashboard/progress }}{{/bars}}
    </div>
    <div class="ma-row-actions">
        {{#actions}}<a class="btn btn-sm ma-btn ma-btn--{{key}}" href="{{url}}"><i class="fa-solid {{icon}} ma-icon" aria-hidden="true"></i>{{label}}<span class="accesshide">: {{name}}</span></a>{{/actions}}
        {{#mitigation}}
        <div class="dropdown ma-mitigate" data-region="ma-mitigate">
            <button type="button" class="btn btn-sm ma-btn ma-btn--mitigate dropdown-toggle" id="{{id}}"
                    data-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><i class="fa-solid {{icon}} ma-icon" aria-hidden="true"></i>{{#str}}action_mitigate, block_le_dashboard{{/str}}</button>
            <div class="dropdown-menu dropdown-menu-right dropdown-menu-end" aria-labelledby="{{id}}">
                {{#links}}{{#url}}<a class="dropdown-item ma-mitigate-item" href="{{url}}">{{label}}</a>{{/url}}{{^url}}<div class="dropdown-item ma-mitigate-item">{{{html}}}</div>{{/url}}{{/links}}
            </div>
        </div>
        {{/mitigation}}
        {{#hasmarkers}}
        <button type="button" class="btn btn-sm ma-btn ma-btn--markers" data-toggle="collapse" data-bs-toggle="collapse"
                data-target="#{{markersid}}" data-bs-target="#{{markersid}}"
                aria-expanded="false" aria-controls="{{markersid}}">{{#str}}action_markers, block_le_dashboard{{/str}}</button>
        {{/hasmarkers}}
    </div>
    {{#hasmarkers}}
    <ul class="list-unstyled collapse ma-markers" id="{{markersid}}" data-region="ma-markers">
        {{#markers}}
        <li class="ma-marker">
            <span class="ma-marker-name">{{name}}</span>
            <div class="ma-marker-bars">{{#bars}}{{> block_le_dashboard/progress }}{{/bars}}</div>
        </li>
        {{/markers}}
    </ul>
    {{/hasmarkers}}
</li>
