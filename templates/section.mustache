{{!
    @template block_my_assessments/section

    A section: one card shape for every section in every view. CSS hooks on the modifier class
    (.ma-view--{view} .ma-section--{key}); JS hooks on data-section only.

    Example context (json):
    {
        "key": "overdue",
        "view": "student",
        "title": "Overdue",
        "count": 1,
        "hasrows": true,
        "hasmore": false,
        "visiblerows": 5,
        "empty": "Nothing overdue.",
        "rows": []
    }
}}
<section class="card ma-section ma-section--{{key}}" data-region="ma-section" data-section="{{key}}" data-visible-rows="{{visiblerows}}">
    <div class="card-header ma-section-header">
        <h3 class="ma-section-title" id="ma-{{view}}-{{key}}-title">{{title}}</h3>
        <span class="badge ma-section-count" data-region="ma-section-count">{{count}}</span>
        <button type="button" class="btn btn-link btn-sm ma-section-toggle" data-action="toggle-section"
                aria-expanded="true" aria-controls="ma-{{view}}-{{key}}-list">
            <i class="fa fa-chevron-down" aria-hidden="true"></i>
            <span class="sr-only">{{#str}}togglesection, block_my_assessments, {{title}}{{/str}}</span>
        </button>
    </div>
    <ul class="list-group list-group-flush ma-rows" id="ma-{{view}}-{{key}}-list" aria-labelledby="ma-{{view}}-{{key}}-title">
        {{#rows}}{{> block_my_assessments/row }}{{/rows}}
    </ul>
    {{^hasrows}}<p class="ma-section-empty text-muted">{{empty}}</p>{{/hasrows}}
    <div class="card-footer ma-section-footer" data-region="ma-more" {{^hasmore}}hidden{{/hasmore}}>
        <button type="button" class="btn btn-link btn-sm ma-more" data-action="show-more" aria-expanded="false">
            <span class="ma-more-label">{{#str}}showmore, block_my_assessments{{/str}}</span>
            <span class="ma-less-label">{{#str}}showless, block_my_assessments{{/str}}</span>
        </button>
    </div>
</section>
