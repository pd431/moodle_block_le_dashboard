{{!
    @template block_le_dashboard/summary_box

    A summary box. Counts arrive as data per assessment type (and per option when the box has a
    dropdown); JS only swaps the number shown. Rows are never counted in the browser.

    Example context (json):
    {
        "key": "duesoon",
        "selectclass": "custom-select custom-select-sm",
        "view": "staff",
        "label": "Deadlines",
        "value": 2,
        "counts": "{\"5\":{\"both\":2,\"summative\":1,\"formative\":1} }",
        "hasoptions": true,
        "options": [{"value": "5", "label": "Within 5 days", "selected": true}],
        "note": null
    }
}}
<div class="card ma-box ma-box--{{key}}{{#hasoptions}} ma-box--options{{/hasoptions}}" data-region="ma-box" data-box="{{key}}" data-counts="{{counts}}">
    <div class="card-body">
        <div class="ma-box-label" id="ma-box-{{view}}-{{key}}">{{label}}</div>
        {{^note}}<div class="ma-box-value" data-region="ma-box-value" aria-describedby="ma-box-{{view}}-{{key}}">{{value}}</div>{{/note}}
        {{#note}}<div class="ma-box-value">{{note}}</div>{{/note}}
        {{#subnote}}<div class="ma-box-note">{{subnote}}</div>{{/subnote}}
        {{#hasoptions}}
        <label class="accesshide" for="ma-box-{{view}}-{{key}}-select">{{label}}</label>
        <select id="ma-box-{{view}}-{{key}}-select" class="{{selectclass}} ma-box-select" data-action="box-option">
            {{#options}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/options}}
        </select>
        {{/hasoptions}}
    </div>
</div>
