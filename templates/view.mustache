{{!
    @template block_my_assessments/view

    One view (student, staff or convenor). Every view has the same shape.

    Example context (json):
    {
        "key": "student",
        "uniqid": "ma1",
        "freshness": {"text": "Updated 12 min ago", "refreshing": false, "preparing": false},
        "hasyears": false,
        "years": [],
        "hassummary": true,
        "summary": [{"key": "overdue", "view": "student", "label": "Overdue", "value": 1, "counts": "{\"both\":1,\"summative\":1,\"formative\":0}", "hasoptions": false}],
        "hasrows": true,
        "sections": [],
        "hasgradestoggle": false,
        "showgrades": false,
        "empty": "You have no assessments to show."
    }
}}
<div class="ma-view ma-view--{{key}}{{#showgrades}} ma-view--showgrades{{/showgrades}}" data-region="ma-view-root" data-view="{{key}}" tabindex="-1">
    {{#freshness.preparing}}
    <div class="alert alert-info ma-preparing" role="status">{{#str}}preparing, block_my_assessments{{/str}}</div>
    {{/freshness.preparing}}
    <div class="ma-toolbar">
        {{#hasyears}}
        <div class="ma-year">
            <label class="sr-only" for="{{uniqid}}-year">{{#str}}academicyear, block_my_assessments{{/str}}</label>
            <select id="{{uniqid}}-year" class="custom-select custom-select-sm" data-action="year">
                {{#years}}<option value="{{id}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/years}}
            </select>
        </div>
        {{/hasyears}}
        <div class="ma-freshness" data-region="ma-freshness">
            {{#freshness.refreshing}}
            <span class="ma-freshness-text">
                <span class="spinner-border spinner-border-sm mr-1" aria-hidden="true"></span>{{#str}}refreshing, block_my_assessments{{/str}}
            </span>
            {{/freshness.refreshing}}
            {{^freshness.refreshing}}
            <span class="ma-freshness-text">{{freshness.text}}</span>
            <button type="button" class="btn btn-sm ma-btn ma-btn--refresh" data-action="refresh">
                <i class="fa fa-rotate-right mr-1" aria-hidden="true"></i>{{#str}}refresh, block_my_assessments{{/str}}
            </button>
            {{/freshness.refreshing}}
        </div>
    </div>

    {{#hassummary}}
    <div class="ma-summary" data-region="ma-summary">
        {{#summary}}{{> block_my_assessments/summary_box }}{{/summary}}
    </div>
    {{/hassummary}}

    <div class="ma-filters">
        <div class="btn-group btn-group-sm ma-type-filter" role="group" aria-label="{{#str}}filtertype, block_my_assessments{{/str}}">
            <button type="button" class="btn ma-filter-btn active" aria-pressed="true" data-action="filter-type" data-type="both">{{#str}}both, block_my_assessments{{/str}}</button>
            <button type="button" class="btn ma-filter-btn" aria-pressed="false" data-action="filter-type" data-type="summative">{{#str}}summative, block_my_assessments{{/str}}</button>
            <button type="button" class="btn ma-filter-btn" aria-pressed="false" data-action="filter-type" data-type="formative">{{#str}}formative, block_my_assessments{{/str}}</button>
        </div>
        <div class="input-group input-group-sm ma-search">
            <div class="input-group-prepend">
                <span class="input-group-text" aria-hidden="true"><i class="fa fa-search"></i></span>
            </div>
            <label class="sr-only" for="{{uniqid}}-search">{{#str}}search, block_my_assessments{{/str}}</label>
            <input type="search" id="{{uniqid}}-search" class="form-control" data-action="search"
                   placeholder="{{searchplaceholder}}">
        </div>
    </div>

    {{#hasrows}}
    {{#sections}}{{> block_my_assessments/section }}{{/sections}}
    <p class="ma-filter-empty text-muted" data-region="ma-filter-empty" hidden>{{#str}}nomatches, block_my_assessments{{/str}}</p>
    {{/hasrows}}
    {{^hasrows}}
    <div class="ma-empty text-muted">{{empty}}</div>
    {{/hasrows}}

    {{#hasgradestoggle}}
    <div class="ma-bottom">
        <button type="button" class="btn btn-sm ma-btn ma-btn--grades" data-action="toggle-grades"
                aria-pressed="{{#showgrades}}true{{/showgrades}}{{^showgrades}}false{{/showgrades}}">
            {{#str}}showgrades, block_my_assessments{{/str}}
        </button>
    </div>
    {{/hasgradestoggle}}
</div>
